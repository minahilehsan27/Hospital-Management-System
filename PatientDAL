        {
            List<string> listOfstrings = new List<string>();
            using (StreamReader reader = new StreamReader("Patient.txt"))
            {
                string? text;
                PatientDTO patient = new PatientDTO();
   
                while ((text = reader.ReadLine()) != null)
                {
                    if (text.StartsWith("Added:"))
                        text = text.Replace("Added:", "");
                    if (string.IsNullOrWhiteSpace(text))
                        continue;
                    patient = JsonSerializer.Deserialize<PatientDTO>(text);
                    if (patient.CNIC != Patient.CNIC)
                        listOfstrings.Add(text);

                }
            }
            using (StreamWriter writer = new StreamWriter("Patient.txt", append: false))
            {
                foreach (string s in listOfstrings)
                    writer.WriteLine("Added:" + s);
            }
            string query2 = "Delete from  Appointment where PatientCNIC = @cnic";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                SqlCommand command = new SqlCommand(query2, connection);
                command.Parameters.AddWithValue("cnic", Patient.CNIC);
                command.ExecuteNonQuery();
            }
            string query1 = "Delete from  Patient where PatientCNIC = @cnic";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                SqlCommand command = new SqlCommand(query1, connection);
                command.Parameters.AddWithValue("cnic", Patient.CNIC);
                command.ExecuteNonQuery();
            }
  
        }
    }
    
}

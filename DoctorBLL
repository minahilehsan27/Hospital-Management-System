using DataAccessLay;
using DataObjectTransferClass;
using System.Numerics;
namespace BuisnessLogicLayer
{
    public class DoctorBLL
    {
        private static DoctorDAL doctorDAL = new DoctorDAL();
        private DoctorDTO ? doctor;
        public void AddDoctor(DoctorDTO dr)
        {
            doctor = new DoctorDTO(GenerateUniqueRandomID(), dr.Name, dr.Specialization, true);
            doctorDAL.AddDoctor(doctor);
        }

        public void MarkUnavailable(DoctorDTO doctor)
        {
            if (doctor.IsAvailable)
            {
                doctor.IsAvailable = false;
            }
        }
        public void MarkAvailable(DoctorDTO doctor)
        {
            if (!doctor.IsAvailable)
            {
                doctor.IsAvailable = true;
            }
        }
        private int GenerateUniqueRandomID()
        {

            Random rand = new Random();
            int randomID = rand.Next();
            while (doctorDAL.IsUniqueDoctorID(randomID) == false)
            {
                randomID = rand.Next(1, int.MaxValue);
            }
            return randomID;
        }
        public List<DoctorDTO> GetAllDoctor()
        {
            return doctorDAL.GetAllDoctors();
        }
        public void updateDoctor(DoctorDTO doctor)
        {
            doctorDAL.UpdateDoctor(doctor);
        }
        public void deleteDoctor(DoctorDTO doctor)
        {
            doctorDAL.DeleteDoctor(doctor);
        }

    }
}
    

    

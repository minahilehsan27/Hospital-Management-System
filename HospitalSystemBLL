        }
        public void AddDoctor(DoctorDTO doctorDTO) 
        {
            doctorBLL.AddDoctor(doctorDTO);
            hospitalsystemDTO.doctors = doctorBLL.GetAllDoctor();
        }
        public void UpdatePatient(String cnic,string name)
        {
            
            bool find = false;
            foreach (PatientDTO patient in hospitalsystemDTO.patients)
            {
                if (patient.CNIC == cnic)
                {
                    patient.Name = name; ;
                    patientBLL.updatePatient(patient);
                    find = true;
                }
            }
            if (!find)
                throw new Exception($"The Patient with this CNIC {cnic} doesn't exsist.");
        }
       public void DisplayPatients()
        {
            foreach(PatientDTO patient in hospitalsystemDTO.patients)
                Console.WriteLine(patient);
        }
        public void DeletePatient(string cnic)
        {
            foreach(PatientDTO patient in hospitalsystemDTO.patients)
            {
                if (patient.CNIC == cnic)
                {
                    patientBLL.deletePatient(patient);
                    hospitalsystemDTO.patients.Remove(patient);
                }
            }
        }

        public void UpdateDoctor(int dId)
        {
            //ask in pl doctor name and all data and pass here the doctor Dto 
            bool find = false;
            foreach (DoctorDTO doctor in hospitalsystemDTO.doctors)
            {
                if (doctor.doctorId == dId)
                {
                    doctorBLL.updateDoctor(doctor);
                    find = true;
                }
            }
            if (!find)
              throw new Exception($"The Doctor with this Id {dId} doesn't exist.");
            
        }
        public void DisplayDoctors()
        {
            foreach(DoctorDTO doctor in hospitalsystemDTO.doctors)
                Console.WriteLine("DoctorId:" + doctor.doctorId + doctor);
        }
        public void DeleteDoctor(int doctorId)
        {
            foreach (DoctorDTO doctor in hospitalsystemDTO.doctors)
            {
                if (doctor.doctorId == doctorId)
                {
                    doctorBLL.deleteDoctor(doctor);
                    hospitalsystemDTO.doctors.Remove(doctor);
                }
            }
        }
        public void BookAppointment(int doctorID, string cnic, DateTime date)
        {
            foreach(DoctorDTO doctor in hospitalsystemDTO.doctors)
            {
                if(doctor.doctorId == doctorID)
                {
                    if (doctor.IsAvailable)
                    {

                        AppointmentDTO appointment = new AppointmentDTO();
                        appointment.DoctorID = doctorID;
                        appointment.PatientCNIC = cnic;
                        appointment.AppointmentDate = date;
                        appointmentBLL.AddAppointment(appointment);
                        hospitalsystemDTO.appointments.Add(appointment);
                    }
                }
            }
        }
        public void CancelAppointment(int appointmentID, string cnic)
        {
            foreach (AppointmentDTO appointment in hospitalsystemDTO.appointments)
            {
                if (appointment.PatientCNIC == cnic)
                {
                    appointmentBLL.cancelAppointment(appointmentID, cnic);
                    hospitalsystemDTO.appointments.Remove(appointment);
                }
            }
        }
        public void DispayAppointmnets()
        {
            foreach (AppointmentDTO appointment in hospitalsystemDTO.appointments)

        private AppointmentBLL appointmentBLL = new AppointmentBLL();
        private static HospitalSystemDTO hospitalsystemDTO = new HospitalSystemDTO();
        public HospitalSystemBLL()
        {
            hospitalsystemDTO.patients = patientBLL.GetAllPatient();
            hospitalsystemDTO.doctors = doctorBLL.GetAllDoctor();
        }
        public void AddPatient(PatientDTO patientDTO)
        {
            patientBLL.AddPatient(patientDTO);

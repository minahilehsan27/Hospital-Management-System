        public void CancelAppointment(int appointmentId, string cnic)
        {

            List<string> listOfstrings = new List<string>();
            try
            {
                using (StreamReader reader = new StreamReader("Appointment.txt"))
                {

                    string? text;
                    AppointmentDTO appointment = new AppointmentDTO();
                    bool check;
                    while ((text = reader.ReadLine()) != null)
                    {
                        if (text.StartsWith("Added:"))
                            text = text.Replace("Added:", "");
                        if (string.IsNullOrWhiteSpace(text))
                            continue;
                        appointment = JsonSerializer.Deserialize<AppointmentDTO>(text);
                        check = (appointment.AppointmentID == appointmentId && appointment.PatientCNIC == cnic);
                        if (!check)
                            listOfstrings.Add(text);
                    }
                }
            }
            catch
            {
                Console.WriteLine($"Warning.");
            }
            using (StreamWriter writer = new StreamWriter("Appointment.txt", append: false))
            {
                foreach (string s in listOfstrings)
                    writer.WriteLine("Added:" + s);
            }
            string query = "Delete from  Appointment where AppointmentId = @Id and PatientCNIC = @cnic";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                SqlCommand command = new SqlCommand(query, connection);
                command.Parameters.AddWithValue("Id",appointmentId);
                command.Parameters.AddWithValue("cnic", cnic);
                command.ExecuteNonQuery();
            }
        }
        public DoctorDTO DoctorWithMaximumRequirements()
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();

     
                string query = "SELECT TOP 1 D.DoctorId,D.Name,D.Specialization, D.IsAvailable,COUNT(D.DoctorId) FROM Doctor D  JOIN  Appointment A ON D.DoctorId = A.DoctorId  GROUP BY  D.DoctorId, D.Name, D.Specialization, D.IsAvailable ORDER BY COUNT(D.DoctorId) DESC"; 


                using (SqlCommand command = new SqlCommand(query, connection))
                using (SqlDataReader reader = command.ExecuteReader())
                {
                    if (reader.HasRows)
                    { 
                        reader.Read();
                        DoctorDTO newDoctor = new DoctorDTO();
                        newDoctor.doctorId = (int)reader["DoctorId"];
                        newDoctor.Name = (string)reader["Name"];
                        newDoctor.Specialization = (string)reader["Specialization"];
                        newDoctor.IsAvailable = (bool)reader["IsAvailable"];
                        return newDoctor;
                    }
                    else
                    {
                        throw new Exception("No appointments have been booked yet.");
                    }
                }
            }
        }

        public void AddAppointment(AppointmentDTO appointment)
        {
            string JsonObject = JsonSerializer.Serialize(appointment);
            using (StreamWriter writer = new StreamWriter("Appointment.txt", append: true))
            {
                writer.WriteLine("Added:" + JsonObject);
            }
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                string query = "INSERT INTO Appointment(AppointmentId,DoctorId,PatientCNIC,AppointmentDate) VALUES(@Id,@doctorId, @PatientCNIC, @date)";
                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.AddWithValue("Id", appointment.AppointmentID);
                    command.Parameters.AddWithValue("doctorId", appointment.DoctorID);
                    command.Parameters.AddWithValue("PatientCNIC", appointment.PatientCNIC);
                    command.Parameters.AddWithValue("date", appointment.AppointmentDate);
                    command.ExecuteNonQuery();
                }
            }
        }
